{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env-usage.mjs",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "oxlint",
