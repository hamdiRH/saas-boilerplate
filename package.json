{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n db,web -c blue,green \"pnpm db:server\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env-usage.mjs",
    "git:pr": "node scripts/git-commit-push-pr.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm check:env && pnpm check:agents && pnpm db:check && pnpm test && pnpm test:browser",
    "fix": "ultracite fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "commit": "cz",
    "knip": "knip",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "check:agents": "node scripts/check-agent-files.mjs",
    "pin": "node scripts/pin-versions.mjs && pnpm install",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "dev:web": "next dev",
    "db:server": "tsx scripts/db-server.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts && pnpm db:seed",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@faker-js/faker": "^10.6.0",
    "@next/bundle-analyzer": "16.4.5",
    "@next/env": "^16.4.6",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "commitizen": "4.3.2",
    "concurrently": "^10.0.7",
    "cross-env": "10.1.0",
    "cz-conventional-changelog": "3.3.0",
    "drizzle-kit": "^0.31.11",
    "jiti": "2.7.0",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{css,json,jsonc,md}": "oxfmt --write"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
