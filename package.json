{
  "name": "nextjs-boilerplate",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n db,web -c blue,green \"pnpm db:server\" \"next dev\"",
    "build": "node scripts/build-sw.mjs && next build",
    "build:sw": "node scripts/build-sw.mjs",
    "start": "node scripts/start-standalone.mjs",
    "docker:up": "pnpm setup:env && docker compose --env-file .env.local up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "azure:setup": "node scripts/azure-devops-setup.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw/tsconfig.json",
    "check:env": "node scripts/check-env-usage.mjs",
    "git:pr": "node scripts/git-commit-push-pr.mjs",
    "git:pr2": "node scripts/git-commit-push-pr2.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm check:env && pnpm check:agents && pnpm db:check && pnpm test && pnpm test:browser",
    "fix": "ultracite fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "commit": "cz",
    "knip": "knip",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "check:agents": "node scripts/check-agent-files.mjs",
    "pin": "node scripts/pin-versions.mjs && pnpm install",
    "versions:record": "node scripts/record-versions.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "dev:web": "next dev",
    "db:server": "tsx scripts/db-server.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts && pnpm db:seed",
    "db:cleanup": "tsx scripts/cleanup-expired.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "setup:env": "node scripts/setup-env.mjs",
    "email:dev": "email dev --dir src/templates/emails --port 3030",
    "auth:schema": "pnpm dlx @better-auth/cli@latest generate --config src/libs/auth.ts --output src/db/schema/auth.generated.ts",
    "azure:backlog": "node scripts/azure-devops-backlog.mjs",
    "azure:sync": "node scripts/azure-boards-sync-check.mjs --org=uzumaki26",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "auth:redirect-uris": "node scripts/auth-redirect-uris.mjs",
    "apple:secret": "tsx scripts/apple-secret.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "^1.7.28",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@hookform/resolvers": "7.0.8",
    "@logtape/logtape": "2.4.2",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.3.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.7.28",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.2",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-socket": "0.2.20",
    "@faker-js/faker": "10.6.0",
    "@next/bundle-analyzer": "16.4.6",
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "commitizen": "4.3.2",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "cz-conventional-changelog": "3.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "jose": "6.2.18",
    "knip": "6.47.0",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "playwright": "1.65.1",
    "react-email": "6.11.16",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "vitest": "5.1.1",
    "vitest-browser-react": "2.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,json,jsonc,md}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
