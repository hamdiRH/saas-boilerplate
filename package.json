{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env-usage.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm check:env && pnpm check:agents && pnpm test && pnpm test:browser",
    "fix": "ultracite fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "commit": "cz",
    "knip": "knip",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "check:agents": "node scripts/check-agent-files.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@next/bundle-analyzer": "16.4.5",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "commitizen": "4.3.2",
    "cross-env": "10.1.0",
    "cz-conventional-changelog": "3.3.0",
    "jiti": "2.7.0",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{css,json,jsonc,md}": "oxfmt --write"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
