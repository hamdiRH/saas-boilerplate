NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Nexora"


# ─── Database ───────────────────────────────────────
# Leave empty locally: `pnpm dev` starts an embedded PGlite server on DB_SERVER_PORT.
# Production: Neon POOLED connection string (host contains "-pooler"), with ?sslmode=verify-full
DATABASE_URL=
# Production migrations: Neon DIRECT connection string
DATABASE_URL_UNPOOLED=
DB_SERVER_PORT=5433
LOG_LEVEL=info

# ─── Email ──────────────────────────────────────────
# Local development prints links in the terminal and stores messages in ./.emails (no setup needed).
# Required for EMAIL_TRANSPORT=resend: use an address on a domain verified in Resend.
EMAIL_FROM=
RESEND_API_KEY=
# console | resend | memory  (leave empty for automatic selection)
EMAIL_TRANSPORT=

# ─── Auth (Better Auth) ─────────────────────────────
# Run `pnpm setup:env` to generate one into .env.local. NEVER commit a real secret.
BETTER_AUTH_SECRET=
AUTH_RATE_LIMIT=on
# Header carrying the real client IP, used by auth rate limiting. The default is correct on Vercel
# (it overwrites x-forwarded-for). Behind any other proxy, set the header YOUR proxy controls.
AUTH_IP_HEADER=x-forwarded-for

# CI/e2e ONLY: allows a production build to use the embedded database and the console email transport.
# Never set this on a real deployment.
ALLOW_LOCAL_SERVICES=false


# ─── PWA & web push (Sprint 2.6) ───────────────────
# "false" at build time ships a self-unregistering worker (kill switch, see docs/guides/pwa.md).
NEXT_PUBLIC_PWA_ENABLED=true
# Web push is off by default. To enable: generate keys with `pnpm exec web-push generate-vapid-keys`.
PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SERVER ONLY. Never expose, never commit.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Magic links ────────────────────────────────────
AUTH_MAGIC_LINK_ENABLED=true
AUTH_ALLOW_SIGNUP_VIA_MAGIC_LINK=true

# ─── Social sign-in (each provider needs BOTH values; see docs/guides/social-auth.md) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Apple's "secret" is a signed JWT that expires every ≤ 6 months: pnpm apple:secret
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── Passkeys ───────────────────────────────────────
# rpID must equal (or be a parent domain of) the site's hostname. Leave empty to derive it.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=