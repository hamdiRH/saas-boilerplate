NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SaaS Boilerplate"


# ─── Database ───────────────────────────────────────
# Leave empty locally: `pnpm dev` starts an embedded PGlite server on DB_SERVER_PORT.
# Production: Neon POOLED connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL=
# Production migrations: Neon DIRECT connection string
DATABASE_URL_UNPOOLED=
DB_SERVER_PORT=5433

LOG_LEVEL=info

# ─── Email ──────────────────────────────────────────
# Local development prints links in the terminal and stores messages in ./.emails (no setup needed).
EMAIL_FROM="SaaS Boilerplate <onboarding@resend.dev>"
RESEND_API_KEY=
# console | resend | memory  (leave empty for automatic selection)
EMAIL_TRANSPORT=

# ─── Auth (Better Auth) ─────────────────────────────
# Run `pnpm setup:env` to generate one into .env.local. NEVER commit a real secret.
BETTER_AUTH_SECRET=